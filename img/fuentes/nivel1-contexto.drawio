ded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b28" value="&lt;b&gt;Enlace oficial&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Consulta de licencias del MTC&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4F9D69;fontColor=#245B36;dashed=1;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="100" y="660" width="300" height="70" as="geometry"/></mxCell><mxCell id="e29" value="Enlace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b30" value="&lt;span style='font-size:12px'&gt;&lt;b&gt;Leyenda:&lt;/b&gt; azul = personas · ámbar = sistema · verde con borde grueso = integración real · gris = verificación del gestor sin conexión directa · línea discontinua = enlace web&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="1660" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>