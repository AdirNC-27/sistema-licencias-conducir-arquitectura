<mxfile host="app.diagrams.net"><diagram id="d" name="Nivel 1 - Contexto"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="&lt;b style=&quot;font-size:18px&quot;&gt;[Diagrama de contexto] Sistema de Licencias de Conducir Clase B&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="b2" value="&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Modelo C4 · Nivel 1 · El sistema como una sola caja, sus usuarios y los sistemas externos · Prototipo académico&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1300" height="22" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sistema de Licencias Clase B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Gestiona el expediente digital, la verificación de documentos y pagos, las citas, las evaluaciones, el seguimiento y la emisión simulada de la licencia&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#9A3412;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="440" height="220" as="geometry"/></mxCell><mxCell id="b4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8A3B12;strokeColor=#6B2C0B;" vertex="1" parent="1"><mxGeometry x="413.0" y="75" width="44" height="44" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b style=&quot;font-size:13px&quot;&gt