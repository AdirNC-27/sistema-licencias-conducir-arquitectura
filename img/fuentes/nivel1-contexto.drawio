value="Consulta respuestas&lt;br&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B4636;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b30" value="&lt;b style=&quot;font-size:13px&quot;&gt;Correo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · opcional]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Avisos fuera de la plataforma&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8E8A86;strokeColor=#6F6B67;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="260" height="80" as="geometry"/></mxCell><mxCell id="e31" value="Envía avisos&lt;br&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B4636;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b32" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="560" height="110" as="geometry"/></mxCell><mxCell id="b33" value="&lt;span style=&quot;font-size:11px&quot;&gt;Persona&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#8A3B12;strokeColor=#6B2C0B;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="816" width="110" height="32" as="geometry"/></mxCell><mxCell id="b34" value="&lt;span style=&quot;font-size:11px&quot;&gt;Sistema&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#9A3412;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="156" y="816" width="110" height="32" as="geometry"/></mxCell><mxCell id="b35" value="&lt;span style=&quot;font-size:11px&quot;&gt;Sistema externo&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8E8A86;strokeColor=#6F6B67;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="278" y="816" width="110" height="32" as="geometry"/></mxCell><mxCell id="b36" value="&lt;span style=&quot;font-size:11px&quot;&gt;Simulado&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8E8A86;strokeColor=#6F6B67;fontColor=#FFFFFF;fontFamily=Helvetica;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#4A4643;" vertex="1" parent="1"><mxGeometry x="400" y="816" width="110" height="32" as="geometry"/></mxCell><mxCell id="b37" value="&lt;span style=&quot;font-size:11px&quot;&gt;Flecha: relación con verbo y [protocolo] · Borde discontinuo grueso: integración simulada en la v1&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="858" width="540" height="24" as="geometry"/></mxCell><mxCell id="b38" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• El sistema se muestra como una sola caja: sin tecnologías ni módulos.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• RENIEC, SNC, banco y centro médico requieren autorización institucional: en la v1 son simulados.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• El correo es opcional: el MVP usa notificaciones internas (RC07).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• El sistema no emite licencias con validez legal (prototipo académico).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="780" width="760" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>