<mxfile host="app.diagrams.net"><diagram id="d" name="Despliegue local"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Diagrama de despliegue · entorno local con Docker&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;span style=&quot;font-size:14px&quot;&gt;Dónde se ejecuta cada contenedor del sistema y cómo se comunican (Sprint 2)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4A86C5;strokeColor=#2F6AA8;" vertex="1" parent="1"><mxGeometry x="560" y="82" width="40" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Usuarios del sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Postulante y personal de la MPH&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#EAF3FF;strokeColor=#4A86C5;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="480" y="112" width="200" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="1180" height="880" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;«nodo» Equipo de desarrollo&lt;/b&gt; · Windows 11 · Docker Desktop (WSL 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="232" width="700" height="26" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Chrome, Edge o Brave&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4A86C5;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="480" y="280" width="200" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFBF0;strokeColor=#D69E2E;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="1100" height="670" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;«entorno de ejecución» Docker Compose&lt;/b&gt; · red interna &lt;i&gt;tecnologia_default&lt;/i&gt; · &lt;span style=&#x27;font-family:Courier New&#x27;&gt;docker compose up --build -d&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=13;fontColor=#7A5200;" vertex="1" parent="1"><mxGeometry x="120" y="410" width="900" height="26" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;licencias-portal&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Contenedor: nginx:1.27-alpine]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Portal React compilado con Vite&lt;br&gt;Rutas del portal → index.html&lt;br&gt;Caché larga de /assets&lt;br&gt;&lt;br&gt;&lt;b&gt;Puerto 8080 → 80&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B4D1F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="330" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;licencias-api&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Contenedor: node:24-alpine · imagen de 2 etapas]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Monolito modular NestJS&lt;br&gt;API REST + Swagger en /api/docs&lt;br&gt;Ejecuta las migraciones al iniciar&lt;br&gt;Caché en memoria de requisitos&lt;br&gt;Reinicio automático (EQ-04)&lt;br&gt;Healthcheck: /api/health&lt;br&gt;&lt;br&gt;&lt;b&gt;Puerto 3000 → 3000&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6A7;strokeColor=#D69E2E;fontColor=#5C3D00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="470" width="360" height="250" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;licencias-db&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Contenedor: postgres:16-alpine]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Base de datos única&lt;br&gt;pg_stat_statements&lt;br&gt;&lt;br&gt;&lt;b&gt;Puerto 5433 → 5432&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fontSize=12;fontFamily=Helvetica;fillColor=#F1EAFB;strokeColor=#7B5EA7;fontColor=#3E2766;" vertex="1" parent="1"><mxGeometry x="590" y="820" width="300" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Volumen&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Courier New&#x27;&gt;datos-postgres&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Los datos sobreviven a&lt;br&gt;docker compose down&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B5EA7;fontColor=#3E2766;" vertex="1" parent="1"><mxGeometry x="980" y="860" width="190" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Configuración&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Variables de laboratorio en el compose&lt;br&gt;Tokens reales en &lt;span style=&#x27;font-family:Courier New&#x27;&gt;backend/.env.docker&lt;/span&gt;&lt;br&gt;(opcional · fuera de Git y de la imagen)&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="140" y="700" width="330" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;API Perú&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Consulta de datos del DNI&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B4D1F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="470" width="300" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Correo electrónico&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Servidor SMTP&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B4D1F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="600" width="300" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1310" y="430" width="340" height="280" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Internet&lt;/b&gt; · servicios externos" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1320" y="436" width="320" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Integración continua · servidores de GitHub]&lt;/span&gt;&lt;br&gt;&lt;br&gt;En cada push construye las mismas&lt;br&gt;imágenes (mismos Dockerfile),&lt;br&gt;comprueba que inician y ejecuta&lt;br&gt;pruebas, contrato y Postman" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#555555;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1330" y="820" width="300" height="150" as="geometry"/></mxCell><mxCell id="c20" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="http://localhost:8080&lt;br&gt;[HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="380"/><mxPoint x="305" y="380"/></Array></mxGeometry></mxCell><mxCell id="c22" value="http://localhost:3000/api&lt;br&gt;[HTTP / JSON + JWT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="380"/><mxPoint x="740" y="380"/></Array></mxGeometry></mxCell><mxCell id="c23" value="db:5432&lt;br&gt;[SQL / TypeORM]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="guarda en" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=none;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Valida el DNI [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="510"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Envía avisos [SMTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="640"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="755"/><mxPoint x="520" y="700"/></Array></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Leyenda:&lt;/b&gt; verde = portal y servicios externos reales · ámbar = API (monolito) · morado = base de datos y su volumen · línea discontinua ámbar = Docker Compose · «nodo» = máquina física" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="1580" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>