ashed=1;strokeColor=#8064A2;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b28" target="b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b53" value="&lt;b&gt;Notación UML&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="760" height="105" as="geometry"/></mxCell><mxCell id="l54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1185" as="sourcePoint"/><mxPoint x="100" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b55" value="&lt;span style=&quot;font-size:10px&quot;&gt;Dependencia (usa)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="106" y="1176" width="115" height="20" as="geometry"/></mxCell><mxCell id="l56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=10;dashed=1;strokeColor=#8064A2;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1185" as="sourcePoint"/><mxPoint x="285" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b57" value="&lt;span style=&quot;font-size:10px&quot;&gt;Implementa interfaz&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="291" y="1176" width="115" height="20" as="geometry"/></mxCell><mxCell id="l58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="1185" as="sourcePoint"/><mxPoint x="470" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b59" value="&lt;span style=&quot;font-size:10px&quot;&gt;Asociación&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="476" y="1176" width="115" height="20" as="geometry"/></mxCell><mxCell id="l60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1185" as="sourcePoint"/><mxPoint x="655" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b61" value="&lt;span style=&quot;font-size:10px&quot;&gt;Composición&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="661" y="1176" width="115" height="20" as="geometry"/></mxCell><mxCell id="b62" value="&lt;span style=&quot;font-size:10px&quot;&gt;Colores por capa: verde = presentación · azul = aplicación · ámbar = dominio · morado = infraestructura. Las flechas del código apuntan hacia el dominio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="730" height="30" as="geometry"/></mxCell><mxCell id="b63" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• El dominio no importa Spring, JPA ni HTTP: se prueba con JUnit sin base de datos.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• Un resultado VALIDADO no se modifica: validar() y corregir() lanzan ResultadoBloqueadoException (DA04).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• Evaluaciones usa a Expedientes solo mediante su API pública (ExpedientesApi).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• Strategy: conocimientos aprueba con 35/40 y manejo con 80/100 (parámetros configurables, RF16).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="1140" width="1060" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>