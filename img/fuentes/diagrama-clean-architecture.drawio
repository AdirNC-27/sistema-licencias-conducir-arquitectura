yle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="380" as="sourcePoint"/><mxPoint x="180" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="380" as="sourcePoint"/><mxPoint x="180" y="765" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="765" as="sourcePoint"/><mxPoint x="290" y="765" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b25" value="&lt;span style='font-size:11px'&gt;usa las&lt;br&gt;interfaces&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="185" y="600" width="70" height="40" as="geometry"/></mxCell><mxCell id="b26" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="1100" y="90" width="370" height="800" as="geometry"/></mxCell><mxCell id="b27" value="&lt;b style='font-size:15px'&gt;Regla de dependencia&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="105" width="330" height="30" as="geometry"/></mxCell><mxCell id="b28" value="&lt;span style='font-size:13px'&gt;Las capas externas dependen de las internas, nunca al revés.&lt;br&gt;&lt;br&gt;El &lt;b&gt;dominio&lt;/b&gt; no conoce Spring Boot, PostgreSQL, React ni API Perú.&lt;br&gt;&lt;br&gt;Por eso las reglas del trámite se prueban sin base de datos.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="140" width="330" height="220" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b style='font-size:15px'&gt;Ejemplo: validar una nota&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="380" width="330" height="30" as="geometry"/></mxCell><mxCell id="b30" value="&lt;span style='font-size:11px;color:#666666'&gt;Presentación&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:13px;font-family:monospace'&gt;EvaluacionesController&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#4F9D69;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="420" width="330" height="70" as="geometry"/></mxCell><mxCell id="b31" value="&lt;span style='font-size:11px;color:#666666'&gt;Aplicación&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:13px;font-family:monospace'&gt;ValidarResultadoUseCase&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#4A86C5;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="510" width="330" height="70" as="geometry"/></mxCell><mxCell id="b32" value="&lt;span style='font-size:11px;color:#666666'&gt;Dominio&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:13px;font-family:monospace'&gt;Evaluacion.validar()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#D69E2E;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="330" height="70" as="geometry"/></mxCell><mxCell id="b33" value="&lt;span style='font-size:11px;color:#666666'&gt;Infraestructura&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:13px;font-family:monospace'&gt;RepositorioEvaluacionesJpa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#8064A2;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="690" width="330" height="70" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="b30" target="b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="b31" target="b32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#8064A2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b33" target="b31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="725"/><mxPoint x="1470" y="545"/></Array></mxGeometry></mxCell><mxCell id="b37" value="&lt;b&gt;Todo apunta hacia el dominio&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFE6A7;strokeColor=#D69E2E;fontColor=#5A3A00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="790" width="330" height="80" as="geometry"/></mxCell><mxCell id="b38" value="&lt;span style='font-size:12px'&gt;&lt;b&gt;Leyenda:&lt;/b&gt; verde = 