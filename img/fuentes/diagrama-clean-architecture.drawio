<mxfile host="app.diagrams.net"><diagram id="d" name="Clean Architecture"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Enfoque arquitectónico · Clean Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="b2" value="&lt;span style=&quot;font-size:14px&quot;&gt;Cada módulo del monolito se organiza en cuatro capas; las dependencias apuntan hacia el dominio&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1500" height="24" as="geometry"/></mxCell><mxCell id="b3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#F8F4FD;strokeColor=#8064A2;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1000" height="800" as="geometry"/></mxCell><mxCell id="b4" value="&lt;span style='color:#245B36'&gt;PRESENTACIÓN&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="460" height="30" as="geometry"/></mxCell><mxCell id="b5" value="&lt;span style='color:#4E3470'&gt;INFRAESTRUCTURA&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="460" height="30" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Controladores REST&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;/api/v1 · JWT por roles · validación de la entrada · respuestas JSON&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4F9D69;fontColor=#245B36;" vertex="1" parent="1"><mxGeometry x="80" y="135" width="440" height="110" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Implementaciones&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Repositorios JPA · PostgreSQL&lt;br&gt;Caché en memoria · ApiPeruDniAdapter&lt;br&gt;AdaptadorIA · NotificadorCorreo&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#F1EAFB;strokeColor=#8064A2;fontColor=#4E3470;" vertex="1" parent="1"><mxGeometry x="600" y="135" width="440" height="110" as="geometry"/></mxCell><mxCell id="b8" value="APLICACIÓN" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#EAF3FF;strokeColor=#4A86C5;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="160" y="280" width="800" height="560" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Casos de uso&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;RegistrarSolicitud · VerificarRequisitos · ProgramarExamen · RegistrarResultado · ValidarResultado · EmitirLicencia&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4A86C5;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="720" height="80" as="geometry"/></mxCell><mxCell id="b10" value="DOMINIO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#FFE6A7;strokeColor=#D69E2E;fontColor=#5A3A00;" vertex="1" parent="1"><mxGeometry x="260" y="430" width="600" height="380" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Entidades&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Expediente · Requisito · Pago · Cita · Evaluacion · Licencia&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D69E2E;fontColor=#4A3300;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="470" width="540" height="90" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Reglas del trámite&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;• Máximo 3 intentos por examen&lt;br&gt;• Certificado médico vigente 6 meses&lt;br&gt;• Manejo solo tras aprobar conocimientos&lt;br&gt;• Resultado validado = bloqueado&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D69E2E;fontColor=#4A3300;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="540" height="120" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Contratos (interfaces)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;RepositorioEvaluaciones · VerificadorIdentidad · ServicioNotificaciones · AsistenteIA&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D69E2E;fontColor=#4A3300;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="730" width="540" height="70" as="geometry"/></mxCell><mxCell id="l14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="245" as="sourcePoint"/><mxPoint x="300" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b15" value="&lt;span style='font-size:11px'&gt;llama&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="262" width="200" height="20" as="geometry"/></mxCell><mxCell id="l16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html