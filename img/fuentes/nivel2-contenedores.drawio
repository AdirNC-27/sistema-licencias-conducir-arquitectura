pan&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Monolito modular. Expone la API REST con JWT, aplica las reglas del trámite y se integra con los sistemas externos mediante adaptadores&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-family:monospace&quot;&gt;12 módulos · Clean Architecture&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E07020;strokeColor=#B85515;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="540" width="380" height="420" as="geometry"/></mxCell><mxCell id="e22" value="Llama a la API&lt;br&gt;[HTTPS/JSON + JWT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B4636;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b23" value="&lt;b style=&quot;font-size:13px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Usuarios, expedientes, pagos, citas, resultados y auditoría&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E07020;strokeColor=#B85515;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="1060" width="270" height="130" as="geometry"/></mxCell><mxCell id="b24" value="&lt;b style=&quot;font-size:13px&quot;&gt;Almacenamiento privado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: compatible S3]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Documentos y comprobantes con acceso restringido&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E07020;strokeColor=#B8