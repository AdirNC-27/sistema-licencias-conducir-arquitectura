# Copie este archivo como .env y complete los valores
PUERTO=3000
JWT_SECRETO=cambie-este-secreto-largo

DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=licencias
DB_CLAVE=licencias
DB_NOMBRE=licencias

# API Perú (ADR-012): token gratuito en https://apiperu.dev
APIPERU_TOKEN=
APIPERU_URL=https://apiperu.dev/api

# Correo SMTP (ADR-013). Ejemplo con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación"
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=Licencias MPH <no-responder@licencias.local>

# IA de orientación (ADR-015): clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Sin clave, el asistente responde con el texto aprobado por el administrador.
IA_API_KEY=
IA_MODELO=gemini-3.1-flash-lite

# Calificación y caché
NOTA_MINIMA=14
CACHE_REQUISITOS=true

# Orígenes permitidos para el portal web (CORS), separados por coma
CORS_ORIGENES=http://localhost:5173
