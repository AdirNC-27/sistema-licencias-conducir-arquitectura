# Copie este archivo como .env y complete los valores
PUERTO=3000
JWT_SECRETO=cambie-este-secreto-largo

DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=licencias
DB_CLAVE=licencias
DB_NOMBRE=licencias

# API Perú (ADR-012): token gratuito en https://apiperu.dev
APIPERU_TOKEN=
APIPERU_URL=https://apiperu.dev/api

# Correo SMTP (ADR-013). Ejemplo con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación"
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=Licencias MPH <no-responder@licencias.local>

# Calificación y caché
NOTA_MINIMA=14
CACHE_REQUISITOS=true
